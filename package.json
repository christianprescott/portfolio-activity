{
  "name": "pi-activity",
  "version": "1.0.0",
  "description": "A minimal activity tracking web server",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node index.ts",
    "build": "esbuild src/components/pi-activity.ts --bundle --format=esm --minify --outfile=public/dist/pi-activity.js",
    "dev": "npm run dev:build & npm run dev:serve",
    "dev:build": "esbuild src/components/pi-activity.ts --bundle --format=esm --sourcemap --banner:js=\"new EventSource('//'+location.hostname+':8000/esbuild').addEventListener('change',()=>setTimeout(()=>location.reload(),150))\" --watch=forever --outfile=public/dist/pi-activity.js",
    "dev:serve": "esbuild src/components/pi-activity.ts public/index.html --loader:.html=copy --entry-names=[name] --bundle --format=esm --sourcemap --banner:js=\"new EventSource('//'+location.hostname+':8000/esbuild').addEventListener('change',()=>setTimeout(()=>location.reload(),150))\" --watch=forever --outdir=public/dist --servedir=public --serve=${DEV_HOST:-0.0.0.0}:8000 --cors-origin=http://${DEV_HOST:-localhost}:3000",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/components",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Pi Agent",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.5",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.16",
    "lit": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3"
  }
}
